APP_NAME="Administración de proyectos"
APP_ENV=local
APP_TIMEZONE=America/Mexico_City
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
DOCENTE_EMAIL_DOMAIN=utvm.edu.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Con Docker, la aplicación usa el servicio "db" y estas credenciales internas.
# Para PHP local, este puerto conecta con la base de Docker publicada en el equipo.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_FORWARD_PORT=3307
DB_DATABASE=administracion_proyectos
DB_USERNAME=laravel
DB_PASSWORD=laravel

# Docker Compose usa estas variables para la base interna del stack.
DOCKER_DB_DATABASE=administracion_proyectos
DOCKER_DB_USERNAME=laravel
DOCKER_DB_PASSWORD=laravel
DOCKER_DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
AUTO_SEED=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP de práctica para comprobar recuperación de acceso y avisos.
# La cola (QUEUE_CONNECTION=database) y el worker deben estar activos para los avisos.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=juanbarrerasanti@gmail.com
MAIL_PASSWORD=pmhtzxnxnktwkeng
MAIL_FROM_ADDRESS="juanbarrerasanti@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
